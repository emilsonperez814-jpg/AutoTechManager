digraph UML1 {
graph [rankdir=BT, nodesep=0.4, ranksep=0.7, fontname="DejaVu Sans", pad=0.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9];
"Persona" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><I>&lt;&lt;abstract&gt;&gt;</I><BR/><B>Persona</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- nombre: String</TD></TR><TR><TD ALIGN="LEFT">- telefono: String</TD></TR><TR><TD ALIGN="LEFT">- activo: boolean</TD></TR><HR/><TR><TD ALIGN="LEFT">+ getRol(): String</TD></TR></TABLE>>];
"Cliente" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>Cliente</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- identidad: String</TD></TR><TR><TD ALIGN="LEFT">- email: String</TD></TR><TR><TD ALIGN="LEFT">- direccion: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ getRol(): String</TD></TR></TABLE>>];
"Mecanico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>Mecanico</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- especialidad: String</TD></TR><TR><TD ALIGN="LEFT">- disponible: boolean</TD></TR><HR/><TR><TD ALIGN="LEFT">+ getRol(): String</TD></TR></TABLE>>];
"Servicio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><I>&lt;&lt;abstract&gt;&gt;</I><BR/><B>Servicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- codigo: String</TD></TR><TR><TD ALIGN="LEFT">- nombre: String</TD></TR><TR><TD ALIGN="LEFT">- costoManoObra: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- tiempoEstimadoHoras: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- activo: boolean</TD></TR><HR/><TR><TD ALIGN="LEFT">+ getNivel(): int</TD></TR><TR><TD ALIGN="LEFT">+ getCategoria(): String</TD></TR><TR><TD ALIGN="LEFT">+ controlesObligatorios(): List&lt;String&gt;</TD></TR></TABLE>>];
"ServicioBasico" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ServicioBasico</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ getNivel(): int</TD></TR></TABLE>>];
"ServicioPreventivo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ServicioPreventivo</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ getNivel(): int</TD></TR><TR><TD ALIGN="LEFT">+ controlesObligatorios()</TD></TR></TABLE>>];
"ServicioIntermedio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ServicioIntermedio</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ getNivel(): int</TD></TR><TR><TD ALIGN="LEFT">+ controlesObligatorios()</TD></TR></TABLE>>];
"ServicioAvanzado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ServicioAvanzado</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ getNivel(): int</TD></TR><TR><TD ALIGN="LEFT">+ controlesObligatorios()</TD></TR></TABLE>>];
"ServicioMayor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ServicioMayor</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ getNivel(): int</TD></TR><TR><TD ALIGN="LEFT">+ controlesObligatorios()</TD></TR></TABLE>>];
"ServicioFactory" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ServicioFactory</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ crear(nivel: int): Servicio</TD></TR></TABLE>>];
"Vehiculo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>Vehiculo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- idCliente: int</TD></TR><TR><TD ALIGN="LEFT">- placa: String</TD></TR><TR><TD ALIGN="LEFT">- vin: String</TD></TR><TR><TD ALIGN="LEFT">- marca: String</TD></TR><TR><TD ALIGN="LEFT">- modelo: String</TD></TR><TR><TD ALIGN="LEFT">- anio: int</TD></TR><TR><TD ALIGN="LEFT">- kilometraje: int</TD></TR><TR><TD ALIGN="LEFT">- combustible: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ descripcion(): String</TD></TR></TABLE>>];
"Repuesto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>Repuesto</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- codigo: String</TD></TR><TR><TD ALIGN="LEFT">- nombre: String</TD></TR><TR><TD ALIGN="LEFT">- categoria: String</TD></TR><TR><TD ALIGN="LEFT">- stock: int</TD></TR><TR><TD ALIGN="LEFT">- stockMinimo: int</TD></TR><TR><TD ALIGN="LEFT">- costoUnitario: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- precioVenta: BigDecimal</TD></TR><HR/><TR><TD ALIGN="LEFT">+ necesitaReposicion(): boolean</TD></TR></TABLE>>];
"Motor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>Motor</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- numeroSerie: String</TD></TR><TR><TD ALIGN="LEFT">- marcaCompatible: String</TD></TR><TR><TD ALIGN="LEFT">- modeloCompatible: String</TD></TR><TR><TD ALIGN="LEFT">- anioDesde: Integer</TD></TR><TR><TD ALIGN="LEFT">- anioHasta: Integer</TD></TR><TR><TD ALIGN="LEFT">- combustible: String</TD></TR><TR><TD ALIGN="LEFT">- estado: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ validarCompatibilidad(v: Vehiculo): List&lt;String&gt;</TD></TR></TABLE>>];
"CambioMotor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>CambioMotor</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idOrden: int</TD></TR><TR><TD ALIGN="LEFT">- idMotorNuevo: int</TD></TR><TR><TD ALIGN="LEFT">- serieAnterior: String</TD></TR><TR><TD ALIGN="LEFT">- estado: String</TD></TR><TR><TD ALIGN="LEFT">- pruebasAprobadas: Boolean</TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"OrdenTrabajo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>OrdenTrabajo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int</TD></TR><TR><TD ALIGN="LEFT">- numero: String</TD></TR><TR><TD ALIGN="LEFT">- idCliente: int</TD></TR><TR><TD ALIGN="LEFT">- idVehiculo: int</TD></TR><TR><TD ALIGN="LEFT">- kilometraje: int</TD></TR><TR><TD ALIGN="LEFT">- sintomas: String</TD></TR><TR><TD ALIGN="LEFT">- idResponsable: int</TD></TR><TR><TD ALIGN="LEFT">- estado: EstadoOrden</TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"EstadoOrden" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><I>&lt;&lt;enum&gt;&gt;</I><BR/><B>EstadoOrden</B></TD></TR><HR/><TR><TD ALIGN="LEFT">RECIBIDA</TD></TR><TR><TD ALIGN="LEFT">EN_DIAGNOSTICO</TD></TR><TR><TD ALIGN="LEFT">PENDIENTE_APROBACION</TD></TR><TR><TD ALIGN="LEFT">EN_REPARACION</TD></TR><TR><TD ALIGN="LEFT">EN_CONTROL_CALIDAD</TD></TR><TR><TD ALIGN="LEFT">FINALIZADA</TD></TR><TR><TD ALIGN="LEFT">RECHAZADA</TD></TR><TR><TD ALIGN="LEFT">CANCELADA</TD></TR><HR/><TR><TD ALIGN="LEFT">+ siguientes(): Set&lt;EstadoOrden&gt;</TD></TR><TR><TD ALIGN="LEFT">+ puedeCambiarA(e): boolean</TD></TR></TABLE>>];
"Presupuesto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>Presupuesto</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- subtotalServicios: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- subtotalRepuestos: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- descuento: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- impuesto: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- total: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">- estado: String</TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"Cliente" -> "Persona" [arrowhead=empty];
"Mecanico" -> "Persona" [arrowhead=empty];
"ServicioBasico" -> "Servicio" [arrowhead=empty];
"ServicioPreventivo" -> "Servicio" [arrowhead=empty];
"ServicioIntermedio" -> "Servicio" [arrowhead=empty];
"ServicioAvanzado" -> "Servicio" [arrowhead=empty];
"ServicioMayor" -> "Servicio" [arrowhead=empty];
"ServicioFactory" -> "Servicio" [style=dashed, arrowhead=vee, label="crea"];
"Vehiculo" -> "Cliente" [arrowhead=odiamond, label="pertenece a  *..1"];
"OrdenTrabajo" -> "EstadoOrden" [arrowhead=vee, label="estado"];
"OrdenTrabajo" -> "Vehiculo" [arrowhead=vee, label="1"];
"OrdenTrabajo" -> "Mecanico" [arrowhead=vee, label="responsable"];
"Presupuesto" -> "OrdenTrabajo" [arrowhead=vee, label="1..*"];
"CambioMotor" -> "OrdenTrabajo" [arrowhead=vee, label="0..1"];
"CambioMotor" -> "Motor" [arrowhead=vee, label="motor nuevo"];
"Motor" -> "Vehiculo" [style=dashed, arrowhead=vee, label="valida contra"];
}