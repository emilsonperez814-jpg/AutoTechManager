digraph UML2 {
graph [rankdir=BT, nodesep=0.35, ranksep=0.8, fontname="DejaVu Sans", pad=0.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9];
"CrudDAO<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>CrudDAO&lt;T&gt;</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ insertar(T): int</TD></TR><TR><TD ALIGN="LEFT">+ actualizar(T)</TD></TR><TR><TD ALIGN="LEFT">+ buscar(id): T</TD></TR><TR><TD ALIGN="LEFT">+ listar(): List&lt;T&gt;</TD></TR><TR><TD ALIGN="LEFT">+ cambiarActivo(id, activo)</TD></TR></TABLE>>];
"BaseDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><I>&lt;&lt;abstract&gt;&gt;</I><BR/><B>BaseDAO</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- compartida: Connection</TD></TR><HR/><TR><TD ALIGN="LEFT"># consultar(sql, mapeador, params)</TD></TR><TR><TD ALIGN="LEFT"># ejecutar(sql, params)</TD></TR><TR><TD ALIGN="LEFT"># insertar(sql, params): int</TD></TR><TR><TD ALIGN="LEFT"># tabla(sql, params): TablaDatos</TD></TR></TABLE>>];
"ClienteDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ClienteDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"VehiculoDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>VehiculoDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"MecanicoDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>MecanicoDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"ServicioDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ServicioDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"RepuestoDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>RepuestoDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"MotorDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>MotorDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"OrdenDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>OrdenDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ finalizar(id) [sp_FinalizarOrden]</TD></TR></TABLE>>];
"PresupuestoDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>PresupuestoDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"FacturacionDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>FacturacionDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ generarFactura(id)</TD></TR><TR><TD ALIGN="LEFT">+ registrarPago(...)</TD></TR></TABLE>>];
"ConsultaDAO" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>ConsultaDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ listados y combos</TD></TR></TABLE>>];
"Conexion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f1f5f9"><TR><TD BGCOLOR="#cbd5e1"><B>Conexion</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ obtener(): Connection</TD></TR><TR><TD ALIGN="LEFT">+ transaccion(Function)</TD></TR><TR><TD ALIGN="LEFT">+ ejecutarEnTransaccion(Consumer)</TD></TR></TABLE>>];
"ClienteService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>ClienteService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ registrar / modificar / cambiarActivo</TD></TR></TABLE>>];
"VehiculoService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>VehiculoService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ registrar / modificar</TD></TR></TABLE>>];
"OrdenService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>OrdenService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ crear(OrdenTrabajo)</TD></TR><TR><TD ALIGN="LEFT">+ cambiarEstado(id, estado)</TD></TR><TR><TD ALIGN="LEFT">+ finalizar(id)</TD></TR></TABLE>>];
"PresupuestoService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>PresupuestoService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ generar(...)</TD></TR><TR><TD ALIGN="LEFT">+ responder(id, aprobado)</TD></TR></TABLE>>];
"InventarioService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>InventarioService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ registrarEntrada(...)</TD></TR><TR><TD ALIGN="LEFT">+ consumir(...) [transaccion]</TD></TR></TABLE>>];
"MotorService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>MotorService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ planificar(...)</TD></TR><TR><TD ALIGN="LEFT">+ registrarDesmontaje / Instalacion / Pruebas</TD></TR><TR><TD ALIGN="LEFT">+ generarGarantia(...)</TD></TR></TABLE>>];
"FacturacionService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>FacturacionService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ facturar(idOrden)</TD></TR><TR><TD ALIGN="LEFT">+ pagar(...)</TD></TR></TABLE>>];
"ReporteService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#cbd5e1"><B>ReporteService</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ ejecutar(nombre)</TD></TR><TR><TD ALIGN="LEFT">+ exportarCsv(...)</TD></TR></TABLE>>];
"ProcesadorOrdenHilo" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fef9c3"><TR><TD BGCOLOR="#cbd5e1"><I>&lt;&lt;Thread&gt;&gt;</I><BR/><B>ProcesadorOrdenHilo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- idOrden: int</TD></TR><TR><TD ALIGN="LEFT">- cancelado: boolean</TD></TR><HR/><TR><TD ALIGN="LEFT">+ run()</TD></TR><TR><TD ALIGN="LEFT">+ cancelar()</TD></TR></TABLE>>];
"NegocioException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fecaca"><TR><TD BGCOLOR="#cbd5e1"><B>NegocioException</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"ValidacionException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fecaca"><TR><TD BGCOLOR="#cbd5e1"><B>ValidacionException</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"DatosException" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fecaca"><TR><TD BGCOLOR="#cbd5e1"><B>DatosException</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ de(SQLException)</TD></TR></TABLE>>];
"VentanaPrincipal" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#cbd5e1"><B>VentanaPrincipal</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
"PnlOrdenes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#cbd5e1"><B>PnlOrdenes</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ refrescar()</TD></TR></TABLE>>];
"PnlMotor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#cbd5e1"><B>PnlMotor</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ refrescar()</TD></TR></TABLE>>];
"PnlDetalleOrden" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#cbd5e1"><I>&lt;&lt;abstract&gt;&gt;</I><BR/><B>PnlDetalleOrden</B></TD></TR><HR/><TR><TD ALIGN="LEFT"># idOrden: int</TD></TR><HR/><TR><TD ALIGN="LEFT">+ cargar(id)</TD></TR><TR><TD ALIGN="LEFT"># refrescarDetalle()</TD></TR></TABLE>>];
"PnlProceso" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#cbd5e1"><B>PnlProceso</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">- procesar()</TD></TR></TABLE>>];
"ClienteDAO" -> "CrudDAO<T>" [style=dashed, arrowhead=empty];
"VehiculoDAO" -> "CrudDAO<T>" [style=dashed, arrowhead=empty];
"MecanicoDAO" -> "CrudDAO<T>" [style=dashed, arrowhead=empty];
"ServicioDAO" -> "CrudDAO<T>" [style=dashed, arrowhead=empty];
"RepuestoDAO" -> "CrudDAO<T>" [style=dashed, arrowhead=empty];
"MotorDAO" -> "CrudDAO<T>" [style=dashed, arrowhead=empty];
"ClienteDAO" -> "BaseDAO" [arrowhead=empty];
"VehiculoDAO" -> "BaseDAO" [arrowhead=empty];
"MecanicoDAO" -> "BaseDAO" [arrowhead=empty];
"ServicioDAO" -> "BaseDAO" [arrowhead=empty];
"RepuestoDAO" -> "BaseDAO" [arrowhead=empty];
"MotorDAO" -> "BaseDAO" [arrowhead=empty];
"OrdenDAO" -> "BaseDAO" [arrowhead=empty];
"PresupuestoDAO" -> "BaseDAO" [arrowhead=empty];
"FacturacionDAO" -> "BaseDAO" [arrowhead=empty];
"ConsultaDAO" -> "BaseDAO" [arrowhead=empty];
"BaseDAO" -> "Conexion" [style=dashed, arrowhead=vee, label="usa"];
"ClienteService" -> "ClienteDAO" [arrowhead=vee];
"VehiculoService" -> "VehiculoDAO" [arrowhead=vee];
"OrdenService" -> "OrdenDAO" [arrowhead=vee];
"PresupuestoService" -> "PresupuestoDAO" [arrowhead=vee];
"InventarioService" -> "RepuestoDAO" [arrowhead=vee];
"MotorService" -> "MotorDAO" [arrowhead=vee];
"FacturacionService" -> "FacturacionDAO" [arrowhead=vee];
"ReporteService" -> "ConsultaDAO" [arrowhead=vee];
"ProcesadorOrdenHilo" -> "OrdenService" [arrowhead=vee];
"PnlProceso" -> "ProcesadorOrdenHilo" [arrowhead=vee, label="inicia"];
"PnlOrdenes" -> "OrdenService" [arrowhead=vee];
"PnlMotor" -> "MotorService" [arrowhead=vee];
"PnlProceso" -> "PnlDetalleOrden" [arrowhead=empty];
"PnlOrdenes" -> "PnlDetalleOrden" [arrowhead=odiamond, label="6 pestañas"];
"VentanaPrincipal" -> "PnlOrdenes" [arrowhead=odiamond];
"VentanaPrincipal" -> "PnlMotor" [arrowhead=odiamond];
"ValidacionException" -> "NegocioException" [arrowhead=empty];
}