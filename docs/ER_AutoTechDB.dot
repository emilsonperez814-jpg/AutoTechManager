"Mecanicos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dcfce7"><B>Mecanicos</B></TD></TR><TR><TD ALIGN="LEFT">IdMecanico</TD><TD ALIGN="LEFT"><FONT COLOR="#b91c1c" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">Nombre</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">Especialidad</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">Activo</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">Disponible</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
