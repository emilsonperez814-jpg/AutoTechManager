digraph ER {
graph [rankdir=TB, splines=true, nodesep=0.25, ranksep=0.7, fontname="DejaVu Sans", bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [color="#475569", arrowtail=tee, arrowhead=crow, dir=both, arrowsize=0.8];
"Clientes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Clientes</B></TD></TR><TR><TD ALIGN="LEFT">IdCliente</TD><TD ALIGN="LEFT"><FONT COLOR="#b91c1c" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">Nombre</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">Identidad</TD><TD ALIGN="LEFT"><FONT COLOR="#b91c1c" POINT-SIZE="8">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT">Telefono</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">Email</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">Activo</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
